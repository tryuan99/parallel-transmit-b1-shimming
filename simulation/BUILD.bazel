load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "b_field",
    srcs = ["b_field.py"],
    deps = [
        ":field_file",
        "//utils:constants",
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("pandas"),
        requirement("SciencePlots"),
    ],
)

py_binary(
    name = "b1_inhomogeneity_analysis_main",
    srcs = ["b1_inhomogeneity_analysis_main.py"],
    data = [
        "//simulation/data:all_data",
        "//simulation/data:all_masks",
    ],
    deps = [
        ":b_field",
        requirement("absl-py"),
    ],
)

py_library(
    name = "b1_shimming_optimization",
    srcs = ["b1_shimming_optimization.py"],
    deps = [
        ":b_field",
        "//optimization:problem",
        requirement("numpy"),
    ],
)

py_binary(
    name = "b1_shimming_magnitude_optimization_main",
    srcs = ["b1_shimming_magnitude_optimization_main.py"],
    data = [
        "//simulation/data:all_data",
        "//simulation/data:all_masks",
    ],
    deps = [
        ":b1_shimming_optimization",
        ":b_field",
        ":field_file",
        "//optimization:pso_single_objective_optimizer",
        requirement("absl-py"),
        requirement("matplotlib"),
        requirement("numpy"),
        requirement("pymoo"),
        requirement("SciencePlots"),
    ],
)

py_binary(
    name = "b1_shimming_viewer_main",
    srcs = ["b1_shimming_viewer_main.py"],
    data = [
        "//simulation/data:all_data",
        "//simulation/data:all_masks",
        "//simulation/results:all_shims",
    ],
    deps = [
        ":b_field",
        ":field_file",
        requirement("absl-py"),
        requirement("numpy"),
        requirement("pandas"),
    ],
)

py_library(
    name = "field_file",
    srcs = ["field_file.py"],
    deps = [requirement("pandas")],
)

py_binary(
    name = "h_field_file_main",
    srcs = ["h_field_file_main.py"],
    data = ["//simulation/data:birdcage_head_data"],
    deps = [
        ":field_file",
        requirement("absl-py"),
    ],
)
